# FlowHRMS environment — copy to .env.local and fill in values.
# .env.local is gitignored; never commit real credentials.

# ---- Supabase (authentication + private file storage) ----
# Project: Supabase dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://mcwuzmzslujnlzagijhc.supabase.co
# Publishable (anon) key — safe for the browser by design.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---- Postgres (Prisma) ----
# Supabase dashboard → Settings → Database → Connection string.
# DATABASE_URL: pooled connection used by the app at runtime.
# DIRECT_URL:   direct connection used by migrations and seeds (CLI).
# For simple local development both may point at the direct connection.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.mcwuzmzslujnlzagijhc.supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@db.mcwuzmzslujnlzagijhc.supabase.co:5432/postgres

# ---- Supabase admin (server-side only) ----
# Needed to CREATE sign-in accounts when you invite an employee.
# Supabase dashboard → Settings → API Keys → secret key (sb_secret_…),
# or the legacy service_role key.
#
# This key bypasses Row Level Security. It has NO `NEXT_PUBLIC_` prefix on
# purpose, and src/lib/supabase/admin.ts is `server-only` so a client
# component importing it fails the build instead of shipping the key.
# Never put it in a browser, a client component, or a git commit.
SUPABASE_SECRET_KEY=

# ---- Outbound email (invitations) ----
# The same credentials you give Supabase for auth emails (DEPLOY.md step 6).
# Without these, employees are still created and FlowHRMS shows a copyable
# invitation link instead of pretending an email was sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="FlowHRMS <no-reply@yourdomain.com>"

# ---- Public site URL ----
# Used to build invitation links. Falls back to the request host, which is
# right in development and usually right in production — set it explicitly
# once you have a domain.
NEXT_PUBLIC_SITE_URL=

# ---- Google Maps (optional) ----
# Browser key: address search when adding a work location, and the field
# trip map. Restricted to the site's domains (DEPLOY.md §7d). Baked in at
# build time, so rebuild after setting it.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Server key: road distance between field visit taps (DEPLOY.md §7e).
# Restricted to the Routes API only. Never exposed to a browser.
GOOGLE_MAPS_SERVER_KEY=

# ---- Backups (office computer only; never on the server) ----
# npm run backup --workspace=@flowhrms/web (OPERATIONS.md → Backup and
# restore). The passphrase is the only way to open a backup: at least 12
# characters, and keep a copy in a password manager.
# BACKUP_PASSPHRASE=
# Where backups go. Default: Google Drive for desktop.
# BACKUP_DIR="G:/My Drive/FlowHRMS-Backups"

# ---- Development only ----
# Renders the app shell with fixture data and NO real authentication.
# Ignored unless NODE_ENV=development. Values: employee | admin | hr |
# manager | owner. See SECURITY-NOTES.md before using.
# FLOWHRMS_DEV_FAKE_SESSION=employee
