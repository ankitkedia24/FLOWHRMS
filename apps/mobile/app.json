{
  "expo": {
    "name": "FlowHRMS",
    "slug": "flowhrms-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "flowhrms",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.flowhrms.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "FlowHRMS uses your location to verify attendance check-ins within designated branch geofences.",
        "NSCameraUsageDescription": "FlowHRMS uses the camera to capture task completion proof and expense receipts.",
        "NSPhotoLibraryUsageDescription": "FlowHRMS needs access to photos to upload receipts and task documentation."
      }
    },
    "android": {
      "package": "com.flowhrms.app",
      "adaptiveIcon": {
        "backgroundColor": "#010123",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "READ_EXTERNAL_STORAGE"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#010123"
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "FlowHRMS uses your location to verify attendance check-ins within designated branch geofences."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "FlowHRMS needs access to your photos to upload receipts and documentation."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
