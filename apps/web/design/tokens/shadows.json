{
  "$schema": "FlowHRMS shadow tokens v1.0 — navy-tinted, never neutral black",
  "shadow": {
    "elevation.0": {
      "value": "none"
    },
    "elevation.1": {
      "value": "0 1px 2px rgba(18,23,46,0.06)",
      "usage": "resting cards, table container"
    },
    "elevation.2": {
      "value": "0 1px 3px rgba(18,23,46,0.08), 0 1px 2px rgba(18,23,46,0.04)",
      "usage": "raised card, hovered row, metric card"
    },
    "elevation.3": {
      "value": "0 4px 12px rgba(18,23,46,0.10)",
      "usage": "dropdown, popover, date picker, toast"
    },
    "elevation.4": {
      "value": "0 12px 32px rgba(18,23,46,0.14)",
      "usage": "modal, drawer, bottom sheet"
    },
    "primaryAction": {
      "value": "0 4px 14px rgba(47,69,196,0.30)",
      "usage": "mobile primary action button only"
    },
    "warmAction": {
      "value": "0 4px 14px rgba(162,69,31,0.24)",
      "usage": "employee success/welcome card only"
    },
    "focusRing": {
      "value": "0 0 0 3px rgba(47,69,196,0.35)",
      "usage": "paired with 2px solid color.border.focus"
    },
    "focusRingDanger": {
      "value": "0 0 0 3px rgba(198,41,60,0.32)"
    },
    "insetTop": {
      "value": "inset 0 1px 0 rgba(255,255,255,0.08)",
      "usage": "dark surfaces only"
    }
  },
  "dark": {
    "note": "multiply alpha by 1.6 and use rgba(5,7,20,…) on dark surfaces; prefer border.default over shadow for separation in dark mode"
  }
}