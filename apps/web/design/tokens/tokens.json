    "card": "admin and desktop surfaces",
    "cardEmployee": "employee mobile surfaces — softer per approved Sahay warmth",
    "sheet": "mobile bottom sheets, top corners only"
  },
  "shadow": {
    "elevation.0": {
      "value": "none"
    },
    "elevation.1": {
      "value": "0 1px 2px rgba(18,23,46,0.06)",
      "usage": "resting cards, table container"
    },
    "elevation.2": {
      "value": "0 1px 3px rgba(18,23,46,0.08), 0 1px 2px rgba(18,23,46,0.04)",
      "usage": "raised card, hovered row, metric card"
    },
    "elevation.3": {
      "value": "0 4px 12px rgba(18,23,46,0.10)",
      "usage": "dropdown, popover, date picker, toast"
    },
    "elevation.4": {
      "value": "0 12px 32px rgba(18,23,46,0.14)",
      "usage": "modal, drawer, bottom sheet"
    },
    "primaryAction": {
      "value": "0 4px 14px rgba(47,69,196,0.30)",
      "usage": "mobile primary action button only"
    },
    "warmAction": {
      "value": "0 4px 14px rgba(162,69,31,0.24)",
      "usage": "employee success/welcome card only"
    },
    "focusRing": {
      "value": "0 0 0 3px rgba(47,69,196,0.35)",
      "usage": "paired with 2px solid color.border.focus"
    },
    "focusRingDanger": {
      "value": "0 0 0 3px rgba(198,41,60,0.32)"
    },
    "insetTop": {
      "value": "inset 0 1px 0 rgba(255,255,255,0.08)",
      "usage": "dark surfaces only"
    }
  },
  "dark": {
    "note": "multiply alpha by 1.6 and use rgba(5,7,20,…) on dark surfaces; prefer border.default over shadow for separation in dark mode"
  },
  "breakpoint": {
    "xs": "360px",
    "sm": "480px",
    "md": "768px",
    "lg": "1024px",
    "xl": "1280px",
    "2xl": "1536px"
  },
  "intent": {
    "xs": "Employee baseline. All employee flows must work fully at 360px.",
    "sm": "Larger phones. Two-up metric cards.",
    "md": "Tablet. Admin becomes usable: collapsed 72px sidebar, cards two-up, tables become scrollable with sticky first column.",
    "lg": "Desktop admin baseline. Full 240px sidebar, full tables.",
    "xl": "Wide admin. Three/four-up metrics, side detail panel instead of drawer.",
    "2xl": "Content capped at layout.contentMaxWidth and centred."
  },
  "rules": [
    "Never use max-width queries as the primary mechanism.",
    "Bottom navigation is shown below md and hidden at md and above.",
    "Sidebar is hidden below md (drawer on demand), collapsed at md, expanded at lg+.",
    "Data tables must switch to the stacked employee-row card pattern below md."
  ],
  "motion": {
    "duration": {
      "instant": "80ms",
      "fast": "120ms",
      "base": "180ms",
      "slow": "260ms",
      "sheet": "320ms",
      "skeleton": "1400ms"
    },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "decelerate": "cubic-bezier(0, 0, 0.2, 1)",
      "accelerate": "cubic-bezier(0.4, 0, 1, 1)",
      "springSubtle": "cubic-bezier(0.34, 1.4, 0.64, 1)"
    },
    "usage": {
      "hover": "duration.fast + easing.standard",
      "press": "duration.instant, scale 0.98 max",
      "toast": "duration.base slide-up 8px + fade",
      "modal": "duration.base fade + scale 0.98→1",
      "drawerSheet": "duration.sheet + easing.decelerate",
      "tabSwitch": "duration.base",
      "toggleSwitch": "duration.fast knob travel",
      "checkInSuccess": "duration.slow + easing.springSubtle, single scale pulse 1→1.03→1, no confetti",
      "skeleton": "duration.skeleton shimmer, linear, infinite"
    },
    "rules": [
      "No animation longer than 320ms in product UI.",
      "No parallax, no auto-playing carousels, no bouncing attention-seekers.",
      "Respect prefers-reduced-motion: replace all transforms with opacity-only changes and disable skeleton shimmer (use a static tint).",
      "Never animate a number counting up in payroll or attendance — figures appear at final value.",
      "Loading spinners only after 400ms of waiting; below that, no indicator."
    ]
  }
}
