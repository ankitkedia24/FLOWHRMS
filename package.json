{
  "name": "flowhrms-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "prisma generate",
    "build": "prisma generate && npm run build --workspace=@flowhrms/web && node scripts/mirror-web-build.mjs",
    "start": "npm run start --workspace=@flowhrms/web",
    "start:root": "next start",
    "dev": "npm run dev --workspace=@flowhrms/web",
    "dev:web": "npm run dev --workspace=@flowhrms/web",
    "dev:mobile": "npm run start --workspace=@flowhrms/mobile",
    "dev:mobile:tunnel": "npm run start --workspace=@flowhrms/mobile -- --tunnel",
    "build:web": "npm run build --workspace=@flowhrms/web",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspace=@flowhrms/web"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.20.4",
    "prisma": "^7.9.1",
    "tsx": "^4.23.9",
    "typescript": "^5"
  }
}
