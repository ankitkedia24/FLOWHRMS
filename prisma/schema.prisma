// FlowHRMS — multi-tenant data foundation (Phase 1).
//
// Boundaries follow SYSTEM-ARCHITECTURE.md: a modular monolith with clear
// domains. Phase 1 ships only the Platform + Shared foundation: identity,
// tenancy, roles/permissions, module & feature entitlement, audit.
// Business-module tables (attendance, leave, payroll, tasks, reporting)
// arrive with their approved detailed rules in later phases.
//
// Tenant isolation (Product Constitution §2): every tenant-owned row carries
// tenantId, and every query must be scoped through the helpers in
// src/lib — never query tenant data without a tenant context.

generator client {
  provider = "prisma-client"
  output   = "../apps/web/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------- identity

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  DEACTIVATED
}

/// A platform login identity. Authentication lives in Supabase Auth;
/// `authUserId` links to auth.users. Workforce/employee profiles are a
/// Phase 2 concern and will link to memberships, not replace them.
model User {
  id             String     @id @default(uuid()) @db.Uuid
  /// Supabase auth.users id. Null until the invite is accepted.
  authUserId     String?    @unique @db.Uuid
  email          String?    @unique
  phone          String?    @unique
  displayName    String
  status         UserStatus @default(ACTIVE)
  /// Platform Super Admin (operates the SaaS across tenants; USER-ROLES.md).
  isPlatformAdmin Boolean   @default(false)
  /// When the mobile number was proven by a one-time code (self sign-up).
  phoneVerifiedAt DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  memberships        TenantMembership[]
  featureExceptions  UserFeatureException[] @relation("exceptionUser")
  auditEvents        AuditEvent[]           @relation("auditActor")
  notifications      Notification[]         @relation("notificationUser")
  demoRequestsHandled DemoRequest[]         @relation("demoRequestHandler")

  @@map("users")
}

// ----------------------------------------------------------------- tenancy

enum TenantStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum TenantPlan {
  TRIAL
  PAID
  INTERNAL
}

enum DemoRequestStatus {
  NEW
  CONTACTED
  CONVERTED
  CLOSED
}

/// An enquiry from the marketing site.
///
/// Deliberately NOT tenant-owned: a prospect has no company here yet, and
/// pretending otherwise would mean inventing a tenant for someone who has
/// not agreed to anything. It is platform data, visible only to a platform
/// admin.
///
/// Only the fields the form already asks for. A prospect gave these to be
/// called back, not to be profiled, so there is no email, no IP, no
/// referrer and no tracking — see the notice on the form itself.
model DemoRequest {
  id       String  @id @default(uuid()) @db.Uuid
  name     String
  company  String
  phone    String
  teamSize String?
  notes    String?

  status      DemoRequestStatus @default(NEW)
  /// Who picked it up, and when. Platform user, so no tenant membership.
  handledById String?           @db.Uuid
  handledAt   DateTime?
  /// What the platform admin recorded about the outcome.
  handledNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  handledBy User? @relation("demoRequestHandler", fields: [handledById], references: [id])

  @@index([status, createdAt])
  @@map("demo_requests")
}

model Tenant {
  id        String       @id @default(uuid()) @db.Uuid
  slug      String       @unique
  name      String
  status    TenantStatus @default(ACTIVE)
  /// Display timezone; storage is UTC (implementation guide §8).
  timezone  String       @default("Asia/Kolkata")
  /// Tenant logo in private storage (V1 theming = logo only).
  logoPath  String?
  /// Optional opening animation the company uploads (GIF, MP4 or WebM, at
  /// most 4 seconds), played once when the app opens.
  splashPath    String?
  splashMime    String?
  splashEnabled Boolean @default(false)
  /// ID card: the company's own background design, and where the photo and
  /// text sit on it (src/lib/idcard/layout.ts).
  idCardBackgroundPath String?
  idCardLayout         Json?
  /// TRIAL companies pause when trialEndsAt passes (data kept); PAID and
  /// INTERNAL (sample, demo and pre-trial companies) never do.
  plan        TenantPlan @default(INTERNAL)
  trialEndsAt DateTime?
  /// Registered through /start rather than by the Flowacord team.
  selfSignup  Boolean    @default(false)
  /// Self-signup only: until the registrant proves their email, the
  /// company cannot invite staff.
  ownerEmailVerifiedAt DateTime?
  /// What the registrant told us at sign-up.
  industry        String?
  staffCount      Int?
  addressPincode  String?
  addressCity     String?
  addressState    String?
  addressCountry  String?
  signupRole      String?
  signupHeardFrom String?
  /// Billing (PAID companies). The plan decides the modules; access runs
  /// to paidUntil, then 7 days' grace, then the company pauses.
  billingPlanId   String?       @db.Uuid
  billingCycle    BillingCycle?
  paidUntil       DateTime?
  /// Who the tax invoice is made out to. Prefilled from the sign-up address.
  billingName     String?
  billingGstin    String?
  billingAddress  String?
  billingCity     String?
  billingState    String?
  billingPincode  String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  memberships       TenantMembership[]
  roles             Role[]
  moduleSettings    TenantModuleSetting[]
  featureSettings   TenantFeatureSetting[]
  featureExceptions UserFeatureException[]
  auditEvents       AuditEvent[]
  branches          Branch[]
  shifts            Shift[]
  attendanceRecords AttendanceRecord[]
  attendancePunches AttendancePunch[]
  leaveRequests     LeaveRequest[]
  tasks             Task[]
  taskProofs        TaskProof[]
  performanceEvents PerformanceEvent[]
  notifications     Notification[]
  salaryComponents  SalaryComponent[]
  salaryStructures  SalaryStructure[]
  payrollRuns       PayrollRun[]
  employeeDocuments EmployeeDocument[]
  /// Tenant-configured policies (attendance, leave, notifications).
  policies          TenantPolicy[]
  departments       Department[]
  employeeInvites   EmployeeInvite[]
  actionRequests    ActionRequest[]
  employeeBadges    EmployeeBadge[]
  performanceBoosts PerformanceBoost[]
  rewards           Reward[]
  rewardRedemptions RewardRedemption[]
  kudos             Kudos[]
  expenseClaims     ExpenseClaim[]
  designations      Designation[]
  fieldPlaces       FieldPlace[]
  fieldTrips        FieldTrip[]
  fieldVisits       FieldVisit[]
  fieldLegs         FieldLeg[]
  fieldConveyances  FieldConveyance[]
  billingPlan       BillingPlan?          @relation(fields: [billingPlanId], references: [id])

  @@map("tenants")
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
  DEACTIVATED
}

/// How someone is engaged. Recorded for the employee record and reports;
/// FlowHRMS attaches NO statutory meaning to these — payroll components are
/// tenant-defined (PRODUCT-CONSTITUTION §6).
enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  TEMPORARY
  APPRENTICE
}

/// A user's place inside one tenant. A user may belong to several tenants;
/// every session resolves exactly one active membership.
model TenantMembership {
  id           String           @id @default(uuid()) @db.Uuid
  tenantId     String           @db.Uuid
  userId       String           @db.Uuid
  roleId       String           @db.Uuid
  status       MembershipStatus @default(ACTIVE)
  employeeCode String?
  /// Home location. Used for reporting, and the ONLY permitted area unless
  /// canCheckInAtAnyBranch is true. Null = location not checked for this person.
  branchId     String?          @db.Uuid
  /// Any ACTIVE company location counts as a permitted area for this person
  /// (delivery, field and relief staff). Admin-set and audited; gated
  /// server-side by the ATTENDANCE.any_branch_check_in feature.
  canCheckInAtAnyBranch Boolean @default(false)
  /// Working shift; null = tenant default shift.
  shiftId      String?          @db.Uuid
  /// Reporting manager.
  reportingToId String?         @db.Uuid
  /// Workforce profile (MODULES.md → Employee Management).
  /// The job title as shown everywhere (payslip, ID card, directory). Kept in
  /// step with designationId, which is what the admin actually picks.
  designation  String?
  /// The company's designation; it also decides the access level (roleId).
  designationId String?         @db.Uuid
  /// Field visits: the vehicle travel allowance is paid for (a key of the
  /// company's field visit rules). Chosen once by the person; an admin
  /// may change it (FIELD-VISITS-MODULE.md §7).
  fieldVehicleKey String?
  /// Profile photo in the private company-media bucket (ID card, directory).
  photoPath    String?
  /// Optional, for the ID card: A+, O-, …
  bloodGroup   String?
  joinedOn     DateTime?        @db.Date
  /// Organisational unit. Null = unassigned; action tiles about this person
  /// then reach tenant admins only, and the directory says so.
  departmentId String?          @db.Uuid
  employmentType EmploymentType @default(FULL_TIME)
  /// When true, `weeklyOffDays` replaces the company's weekly off for this
  /// person (0 = Sunday … 6 = Saturday). Shop staff often take a weekday.
  hasOwnWeeklyOff Boolean       @default(false)
  weeklyOffDays   Int[]         @default([])
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  tenant Tenant  @relation(fields: [tenantId], references: [id])
  user   User    @relation(fields: [userId], references: [id])
  role   Role    @relation(fields: [roleId], references: [id])
  designationRef Designation? @relation(fields: [designationId], references: [id])
  branch Branch? @relation(fields: [branchId], references: [id])
  shift  Shift?  @relation(fields: [shiftId], references: [id])
  reportingTo TenantMembership?  @relation("reporting", fields: [reportingToId], references: [id])
  reports     TenantMembership[] @relation("reporting")

  department        Department?        @relation("departmentMembers", fields: [departmentId], references: [id])
  headOfDepartments Department[]       @relation("departmentHead")
  invites           EmployeeInvite[]
  actionRequestsAbout ActionRequest[]  @relation("actionAbout")

  attendanceRecords AttendanceRecord[]
  leaveRequests     LeaveRequest[]     @relation("leaveRequester")
  tasksAssigned     Task[]             @relation("taskAssignee")
  tasksCreated      Task[]             @relation("taskCreator")
  salaryStructures  SalaryStructure[]
  payrollLines      PayrollLine[]
  documents         EmployeeDocument[]
  performanceEvents PerformanceEvent[]
  badges            EmployeeBadge[]
  rewardRedemptions RewardRedemption[]
  kudosSent         Kudos[]            @relation("kudosFrom")
  kudosReceived     Kudos[]            @relation("kudosTo")
  expenseClaims     ExpenseClaim[]
  fieldTrips        FieldTrip[]
  fieldConveyances  FieldConveyance[]

  @@unique([tenantId, userId])
  /// An employee code identifies one person within one company. NULLs stay
  /// distinct in Postgres, so people without a code are unaffected.
  @@unique([tenantId, employeeCode])
  @@index([tenantId, departmentId])
  @@index([tenantId, status])
  @@index([tenantId, branchId])
  @@index([userId])
  @@map("tenant_memberships")
}

// ------------------------------------------------------- workforce basics

/// A permitted place of work (MODULES.md: branches under tenant settings).
/// "Geofence" is admin vocabulary only — employees see "permitted area".
model Branch {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String  @db.Uuid
  name     String
  address  String?
  lat      Float?
  lng      Float?
  /// Per-location override of the permitted-area radius in metres.
  /// NULL = inherit the tenant's attendance policy radius. A warehouse may
  /// need 500 m where a shop needs 100 m (Constitution §1).
  radiusM  Int?
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  memberships       TenantMembership[]
  attendanceRecords AttendanceRecord[]
  attendancePunches AttendancePunch[]

  @@index([tenantId, isActive])
  @@map("branches")
}

/// A working shift. Times are minutes from midnight in the tenant timezone.
model Shift {
  id           String  @id @default(uuid()) @db.Uuid
  tenantId     String  @db.Uuid
  name         String
  startMinutes Int
  endMinutes   Int
  /// Grace is INCLUSIVE: exactly graceMinutes late is not late (edge-cases).
  graceMinutes Int     @default(10)
  isDefault    Boolean @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant      Tenant             @relation(fields: [tenantId], references: [id])
  memberships TenantMembership[]

  @@index([tenantId])
  @@map("shifts")
}

// ------------------------------------------------------------- attendance

enum LocationOutcome {
  /// Inside the permitted area.
  INSIDE
  /// Outside the permitted area — needs approval (exception).
  OUTSIDE
  /// Location could not be confirmed (off, or accuracy worse than 200 m).
  UNCONFIRMED
  /// Policy does not require location for this person.
  NOT_REQUIRED
}

enum ReviewStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
  DETAILS_REQUESTED
}

enum ExemptionStatus {
  NONE
  REQUESTED
  EXEMPTED
  DECLINED
}

/// One membership-day of attendance evidence. V1 is single punch per day
/// unless the multiple_punch feature is enabled (not in this phase).
/// Server time is authoritative; the client capture time is preserved for
/// offline records (edge-cases.md).
model AttendanceRecord {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  membershipId String   @db.Uuid
  /// Work date in the tenant's timezone (date only).
  workDate     DateTime @db.Date

  checkInAt         DateTime?
  /// Original device capture time (offline records keep it; server wins).
  checkInClientAt   DateTime?
  checkInLat        Float?
  checkInLng        Float?
  checkInAccuracyM  Float?
  checkInDistanceM  Float?
  checkInOutcome    LocationOutcome?
  /// Employee's reason — required for outside-area check-ins.
  checkInReason     String?
  offlineCaptured   Boolean @default(false)

  lateMinutes     Int             @default(0)
  exemptionStatus ExemptionStatus @default(NONE)
  exemptionReason String?

  checkOutAt       DateTime?
  checkOutClientAt DateTime?
  checkOutLat      Float?
  checkOutLng      Float?
  checkOutOutcome  LocationOutcome?

  /// A queued check-in arrived after the day already had a record with a
  /// different time. The server record stands; this preserves the losing
  /// version so an admin can see both (edge-cases.md → sync conflict).
  conflictNote  String?

  /// Exception review (Approval card contract; Constitution §3).
  reviewStatus  ReviewStatus @default(NONE)
  reviewedById  String?      @db.Uuid
  reviewedAt    DateTime?
  reviewReason  String?

  /// The location this check-in was ASSESSED AGAINST (the nearest permitted
  /// area), which for roaming staff need not be their home location.
  branchId String? @db.Uuid
  /// Policy values in force when recorded (never retroactively rewritten).
  /// v2 carries branches by value so a later rename cannot change what a
  /// past record says. See lib/attendance/policy.ts → AttendanceSnapshot.
  policySnapshot Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant     Tenant           @relation(fields: [tenantId], references: [id])
  membership TenantMembership @relation(fields: [membershipId], references: [id])
  branch     Branch?          @relation(fields: [branchId], references: [id])

  punches    AttendancePunch[]
  fieldTrips FieldTrip[]

  @@unique([tenantId, membershipId, workDate])
  @@index([tenantId, workDate])
  @@index([tenantId, reviewStatus])
  @@index([tenantId, branchId, workDate])
  @@map("attendance_records")
}

/// One in-and-out pair inside a work day.
///
/// The day record above stays the summary — first check-in, lateness,
/// review status — because payroll counts DAYS PRESENT and must not change
/// shape when someone steps out for lunch. This table carries the detail,
/// so a break is not counted as worked time and each return to work keeps
/// its own location.
///
/// A day always has at least one punch. Additional ones exist only where
/// ATTENDANCE.multiple_punch is on; the feature is the gate, this is the
/// storage (Constitution §5).
model AttendancePunch {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  recordId String @db.Uuid
  /// 1 for the day's first pair, then 2, 3 — the order they happened.
  sequence Int

  checkInAt        DateTime
  /// Original device capture time, as on the day record.
  checkInClientAt  DateTime?
  checkInLat       Float?
  checkInLng       Float?
  checkInAccuracyM Float?
  checkInDistanceM Float?
  checkInOutcome   LocationOutcome?
  /// Required when this pair started outside the permitted area.
  checkInReason    String?
  offlineCaptured  Boolean          @default(false)

  /// Null while this pair is open — the person is working right now.
  checkOutAt       DateTime?
  checkOutClientAt DateTime?
  checkOutLat      Float?
  checkOutLng      Float?
  checkOutOutcome  LocationOutcome?

  /// Assessed against this location, which can differ between punches for
  /// roaming staff.
  branchId String? @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant           @relation(fields: [tenantId], references: [id])
  record AttendanceRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  branch Branch?          @relation(fields: [branchId], references: [id])

  @@unique([recordId, sequence])
  @@index([tenantId, checkInAt])
  @@map("attendance_punches")
}

// ------------------------------------------------------------ performance

/**
 * One earned award. Append-only, like the audit log: corrections are new
 * visible entries, never rewrites (Constitution §3).
 *
 * Points derive only from attendance and task evidence (MODULES.md;
 * PERFORMANCE-MODULE.md). Every row stamps the scoring policy version
 * that produced it, and `dedupeKey` makes double-awarding structurally
 * impossible — one award per source event, one aggregate per period.
 */
model PerformanceEvent {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  membershipId String   @db.Uuid
  /// The day this credits to, in the tenant's timezone (date only).
  workDate     DateTime @db.Date
  /// Rule key from the scoring policy, e.g. "on_time", "perfect_week".
  kind         String
  points       Int
  /// What produced it: "attendance_record" | "task" | "task_proof" | ...
  sourceType   String
  sourceId     String?  @db.Uuid
  /// Uniqueness handle: a source id, or a period key like "2026-W34".
  dedupeKey    String
  /// Scoring policy version in force when awarded.
  policyVersion Int
  /// Human line shown in the ledger, written once at award time.
  note         String
  createdAt    DateTime @default(now())

  tenant     Tenant           @relation(fields: [tenantId], references: [id])
  membership TenantMembership @relation(fields: [membershipId], references: [id])

  @@unique([tenantId, membershipId, kind, dedupeKey])
  @@index([tenantId, membershipId, workDate])
  @@index([tenantId, workDate])
  @@map("performance_events")
}

// ------------------------------------------------------------------ leave

enum LeaveType {
  FULL_DAY
  HALF_DAY
  EMERGENCY
}

enum HalfDayPart {
  FIRST_HALF
  SECOND_HALF
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  DETAILS_REQUESTED
}

model LeaveRequest {
  id           String      @id @default(uuid()) @db.Uuid
  tenantId     String      @db.Uuid
  membershipId String      @db.Uuid
  type         LeaveType
  startDate    DateTime    @db.Date
  endDate      DateTime    @db.Date
  halfDayPart  HalfDayPart?
  reason       String
  /// Idempotency key from the device. A request queued offline may be
  /// retried; this makes a duplicate impossible rather than unlikely.
  clientRequestId String?  @db.Uuid
  /// Original device capture time for requests made offline.
  clientCapturedAt DateTime?
  /// Computed at request time from policy; the approver can change it.
  unpaidDays   Float       @default(0)
  status       LeaveStatus @default(PENDING)
  /// Decision (Constitution §3): approved as paid or unpaid, with reason.
  paid          Boolean?
  decidedById   String?   @db.Uuid
  decidedAt     DateTime?
  decisionReason String?
  cancelledAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant     Tenant           @relation(fields: [tenantId], references: [id])
  membership TenantMembership @relation("leaveRequester", fields: [membershipId], references: [id])

  @@unique([tenantId, clientRequestId])
  @@index([tenantId, status])
  @@index([tenantId, membershipId, startDate])
  @@map("leave_requests")
}

// ------------------------------------------------------------------ tasks

enum TaskPriority {
  HIGH
  MEDIUM
  LOW
}

enum ProofRequirement {
  NONE
  PHOTO
  FILE
}

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED_FOR_REVIEW
  COMPLETED
}

model Task {
  id           String           @id @default(uuid()) @db.Uuid
  tenantId     String           @db.Uuid
  createdById  String           @db.Uuid
  assigneeId   String           @db.Uuid
  title        String
  description  String?
  priority     TaskPriority     @default(MEDIUM)
  dueDate      DateTime?        @db.Date
  /// Optional time-of-day deadline (minutes from midnight, tenant tz).
  dueMinutes   Int?
  proofRequirement ProofRequirement @default(NONE)
  status       TaskStatus       @default(NOT_STARTED)
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  tenant    Tenant           @relation(fields: [tenantId], references: [id])
  createdBy TenantMembership @relation("taskCreator", fields: [createdById], references: [id])
  assignee  TenantMembership @relation("taskAssignee", fields: [assigneeId], references: [id])
  proofs    TaskProof[]

  @@index([tenantId, assigneeId, status])
  @@index([tenantId, status])
  @@map("tasks")
}

model TaskProof {
  id            String       @id @default(uuid()) @db.Uuid
  tenantId      String       @db.Uuid
  taskId        String       @db.Uuid
  submittedById String       @db.Uuid
  note          String?
  /// Idempotency key from the device (see LeaveRequest.clientRequestId).
  clientRequestId String?    @db.Uuid
  /// Original device capture time when submitted offline.
  clientCapturedAt DateTime?
  submittedAt   DateTime     @default(now())
  decision      ReviewStatus @default(PENDING)
  decidedById   String?      @db.Uuid
  decidedAt     DateTime?
  decisionReason String?

  tenant Tenant      @relation(fields: [tenantId], references: [id])
  task   Task        @relation(fields: [taskId], references: [id])
  files  ProofFile[]

  @@unique([tenantId, clientRequestId])
  @@index([tenantId, taskId])
  @@map("task_proofs")
}

/// Stored in the private Supabase bucket; paths are tenant-prefixed and
/// only ever served through signed URLs (SYSTEM-ARCHITECTURE security).
model ProofFile {
  id        String @id @default(uuid()) @db.Uuid
  tenantId  String @db.Uuid
  proofId   String @db.Uuid
  path      String
  name      String
  mime      String
  sizeBytes Int

  proof TaskProof @relation(fields: [proofId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("proof_files")
}

// ------------------------------------------------------ employee documents

enum DocumentStatus {
  PENDING_REVIEW
  VERIFIED
  REJECTED
}

/// An employee's document (ID, address proof, certificate).
///
/// Privacy (Constitution §7): the file lives in a PRIVATE bucket, is read
/// only through short-lived signed URLs, and every download is audited.
/// Visible to the employee, HR and permitted roles — stated on screen at
/// the point of capture.
model EmployeeDocument {
  id           String         @id @default(uuid()) @db.Uuid
  tenantId     String         @db.Uuid
  membershipId String         @db.Uuid
  /// Free-text kind chosen by the tenant ("ID proof", "Address proof").
  kind         String
  name         String
  path         String
  mime         String
  sizeBytes    Int
  status       DocumentStatus @default(PENDING_REVIEW)
  uploadedById String?        @db.Uuid
  uploadedAt   DateTime       @default(now())
  reviewedById String?        @db.Uuid
  reviewedAt   DateTime?
  reviewReason String?

  tenant     Tenant           @relation(fields: [tenantId], references: [id])
  membership TenantMembership @relation(fields: [membershipId], references: [id])

  @@index([tenantId, membershipId])
  @@index([tenantId, status])
  @@map("employee_documents")
}

// --------------------------------------------------------------- policies

/// Versioned tenant policy documents (Constitution §1, edge-cases.md:
/// "Records keep the policy_version in force on that date"). A change
/// creates a NEW version; past records keep the version that applied.
model TenantPolicy {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  /// attendance | leave | payroll | notifications | pay_setup | performance
  /// | expenses | work_calendar | field_visits
  key       String
  version   Int      @default(1)
  value     Json
  isCurrent Boolean  @default(true)
  updatedById String? @db.Uuid
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, key, version])
  @@index([tenantId, key, isCurrent])
  @@map("tenant_policies")
}

// ---------------------------------------------------------------- payroll

enum ComponentKind {
  EARNING
  DEDUCTION
}

enum ComponentCalculation {
  /// A fixed monthly rupee amount.
  FIXED
  /// A percentage of the structure's base amount.
  PERCENT_OF_BASE
  /// A fixed amount multiplied by payable days.
  PER_DAY
}

/// A salary component defined BY THE TENANT (Constitution §1: configuration
/// before custom code). FlowHRMS ships no statutory formulas: PF, ESI, PT, TDS
/// and similar are configured here by the customer's accountant and marked
/// `isStatutory` so the UI can say so plainly. FlowHRMS never certifies them.
model SalaryComponent {
  id          String               @id @default(uuid()) @db.Uuid
  tenantId    String               @db.Uuid
  key         String
  name        String
  kind        ComponentKind
  calculation ComponentCalculation @default(FIXED)
  /// True when the tenant marks this as defined by their accountant.
  isStatutory Boolean              @default(false)
  /// Whether unpaid days reduce this component (pro-rating).
  prorated    Boolean              @default(true)
  sortOrder   Int                  @default(0)
  isActive    Boolean              @default(true)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  tenant Tenant                @relation(fields: [tenantId], references: [id])
  lines  SalaryStructureLine[]

  @@unique([tenantId, key])
  @@map("salary_components")
}

/// One employee's salary definition, effective from a date. A new
/// structure supersedes the previous one; history is never overwritten.
model SalaryStructure {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  membershipId  String   @db.Uuid
  effectiveFrom DateTime @db.Date
  /// Base figure percentage components resolve against.
  baseAmount    Decimal  @db.Decimal(12, 2)
  note          String?
  createdById   String?  @db.Uuid
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant     Tenant                @relation(fields: [tenantId], references: [id])
  membership TenantMembership      @relation(fields: [membershipId], references: [id])
  lines      SalaryStructureLine[]

  @@unique([tenantId, membershipId, effectiveFrom])
  @@index([tenantId, membershipId])
  @@map("salary_structures")
}

model SalaryStructureLine {
  id          String  @id @default(uuid()) @db.Uuid
  structureId String  @db.Uuid
  componentId String  @db.Uuid
  /// Used by FIXED and PER_DAY.
  amount      Decimal @db.Decimal(12, 2) @default(0)
  /// Used by PERCENT_OF_BASE (0–100).
  percent     Decimal @db.Decimal(6, 3) @default(0)

  structure SalaryStructure @relation(fields: [structureId], references: [id], onDelete: Cascade)
  component SalaryComponent @relation(fields: [componentId], references: [id])

  @@unique([structureId, componentId])
  @@map("salary_structure_lines")
}

enum PayrollRunStatus {
  DRAFT
  APPROVED
}

/// A payroll period for one tenant. Approval LOCKS it; later changes are
/// only auditable adjustments (Constitution §6).
model PayrollRun {
  id          String           @id @default(uuid()) @db.Uuid
  tenantId    String           @db.Uuid
  /// First day of the payroll month (date only).
  periodMonth DateTime         @db.Date
  status      PayrollRunStatus @default(DRAFT)
  /// Inputs and policy in force when calculated — payroll traceability.
  inputsSnapshot Json?
  calculatedAt   DateTime?
  approvedById   String?   @db.Uuid
  approvedAt     DateTime?
  approvalReason String?
  /// Required acknowledgement: figures checked with the tenant's
  /// accountant. FlowHRMS does not certify statutory compliance (D-019).
  accountantAcknowledged Boolean @default(false)
  grossTotal     Decimal   @default(0) @db.Decimal(14, 2)
  deductionTotal Decimal   @default(0) @db.Decimal(14, 2)
  netTotal       Decimal   @default(0) @db.Decimal(14, 2)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant Tenant        @relation(fields: [tenantId], references: [id])
  lines  PayrollLine[]

  @@unique([tenantId, periodMonth])
  @@index([tenantId, status])
  @@map("payroll_runs")
}

enum PayrollLineStatus {
  READY
  NO_SALARY_STRUCTURE
  BLOCKED
}

model PayrollLine {
  id           String            @id @default(uuid()) @db.Uuid
  tenantId     String            @db.Uuid
  runId        String            @db.Uuid
  membershipId String            @db.Uuid
  status       PayrollLineStatus @default(READY)
  /// Why a line is blocked or excluded, stated plainly.
  statusReason String?

  calendarDays   Int     @default(0)
  /// Calendar days split for the payslip. 0 on lines approved before the
  /// work calendar existed, which show the older "days in period" view.
  workingDays    Int     @default(0)
  weeklyOffDays  Int     @default(0)
  holidayDays    Int     @default(0)
  presentDays    Decimal @default(0) @db.Decimal(6, 2)
  paidLeaveDays  Decimal @default(0) @db.Decimal(6, 2)
  unpaidDays     Decimal @default(0) @db.Decimal(6, 2)
  payableDays    Decimal @default(0) @db.Decimal(6, 2)
  lateMinutes    Int     @default(0)
  lateDeductionDays Decimal @default(0) @db.Decimal(6, 2)

  /// Per-component breakdown so every figure traces to its input.
  earnings   Json?
  deductions Json?

  gross          Decimal @default(0) @db.Decimal(12, 2)
  deductionTotal Decimal @default(0) @db.Decimal(12, 2)
  adjustmentTotal Decimal @default(0) @db.Decimal(12, 2)
  net            Decimal @default(0) @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  run         PayrollRun          @relation(fields: [runId], references: [id], onDelete: Cascade)
  membership  TenantMembership    @relation(fields: [membershipId], references: [id])
  adjustments PayrollAdjustment[]

  @@unique([runId, membershipId])
  @@index([tenantId, runId])
  @@map("payroll_lines")
}

/// The only sanctioned way to change money after approval: an adjustment
/// with a reason and an actor. Payroll is never overwritten.
model PayrollAdjustment {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  lineId      String   @db.Uuid
  label       String
  /// Signed: positive adds to net pay, negative reduces it.
  amount      Decimal  @db.Decimal(12, 2)
  reason      String
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())

  line PayrollLine @relation(fields: [lineId], references: [id], onDelete: Cascade)

  @@index([tenantId, lineId])
  @@map("payroll_adjustments")
}

// ---------------------------------------------------------- notifications

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  userId    String    @db.Uuid
  title     String
  body      String?
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation("notificationUser", fields: [userId], references: [id])

  @@index([tenantId, userId, readAt])
  @@map("notifications")
}

// -------------------------------------------------------- roles & permissions

/// Role templates per tenant (USER-ROLES.md): roles are templates,
/// granular permissions are the enforcement unit.
model Role {
  id          String  @id @default(uuid()) @db.Uuid
  tenantId    String  @db.Uuid
  /// Stable key: OWNER, SUPER_ADMIN, ADMIN, HR, MANAGER, TEAM_LEADER,
  /// EMPLOYEE, VIEWER.
  key         String
  name        String
  description String?
  /// System templates are seeded and cannot be deleted, only re-permissioned.
  isSystem    Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  permissions RolePermission[]
  memberships TenantMembership[]
  designations Designation[]

  @@unique([tenantId, key])
  @@map("roles")
}

/// Global permission catalog. `isSensitive` marks the separately-permissioned
/// set from USER-ROLES.md (salary, bank, documents, location, export, audit).
model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  key         String  @unique
  name        String
  description String?
  isSensitive Boolean @default(false)

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ------------------------------------------------------- modules & features

enum ModuleCategory {
  /// Always-on platform capability (identity, audit, notifications plumbing).
  CORE
  /// V1 business module, toggleable per tenant.
  STANDARD
  /// Optional module: enabled per tenant only after its rules are approved.
  OPTIONAL
}

/// Platform module catalog (MODULES.md).
model Module {
  id          String         @id @default(uuid()) @db.Uuid
  key         String         @unique
  name        String
  description String?
  category    ModuleCategory @default(STANDARD)
  sortOrder   Int            @default(0)

  features       Feature[]
  tenantSettings TenantModuleSetting[]
  /// Modules this module requires.
  requires   ModuleDependency[] @relation("dependent")
  /// Modules that require this module.
  requiredBy ModuleDependency[] @relation("requirement")

  @@map("modules")
}

/// Dependency rules (MODULES.md). Rows sharing a non-null `anyOfGroup`
/// are satisfied when ANY one of the group is enabled (e.g. Performance
/// requires Attendance OR Tasks); rows with a null group are ALL required.
model ModuleDependency {
  id                String  @id @default(uuid()) @db.Uuid
  moduleId          String  @db.Uuid
  requiresModuleId  String  @db.Uuid
  anyOfGroup        String?

  module   Module @relation("dependent", fields: [moduleId], references: [id], onDelete: Cascade)
  requires Module @relation("requirement", fields: [requiresModuleId], references: [id], onDelete: Cascade)

  @@unique([moduleId, requiresModuleId])
  @@map("module_dependencies")
}

/// A controlled capability inside a module (FEATURE-FLAGS.md initial flags).
model Feature {
  id             String  @id @default(uuid()) @db.Uuid
  moduleId       String  @db.Uuid
  key            String
  name           String
  description    String?
  defaultEnabled Boolean @default(false)

  module         Module                 @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  tenantSettings TenantFeatureSetting[]
  userExceptions UserFeatureException[]

  @@unique([moduleId, key])
  @@map("features")
}

/// Tenant-scope module entitlement. Absence of a row = disabled.
model TenantModuleSetting {
  tenantId  String   @db.Uuid
  moduleId  String   @db.Uuid
  enabled   Boolean  @default(false)
  /// Set from the Flowacord platform area. When false the company cannot
  /// switch the module on itself ("Not in your plan").
  allowedByPlatform Boolean @default(true)
  updatedAt DateTime @updatedAt
  updatedById String? @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id])
  module Module @relation(fields: [moduleId], references: [id])

  @@id([tenantId, moduleId])
  @@map("tenant_module_settings")
}

/// Tenant-scope feature setting. `policy` holds the tenant's business
/// choice for policy-scope flags (grace minutes, geofence radius, …) —
/// versioned policy documents arrive with the business modules.
model TenantFeatureSetting {
  tenantId  String   @db.Uuid
  featureId String   @db.Uuid
  enabled   Boolean  @default(false)
  policy    Json?
  updatedAt DateTime @updatedAt
  updatedById String? @db.Uuid

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  feature Feature @relation(fields: [featureId], references: [id])

  @@id([tenantId, featureId])
  @@map("tenant_feature_settings")
}

/// User-scope exception (FEATURE-FLAGS.md flag scopes): an approved
/// per-person override, time-bound where possible, always audited.
model UserFeatureException {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  userId      String    @db.Uuid
  featureId   String    @db.Uuid
  enabled     Boolean
  reason      String?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  createdById String?   @db.Uuid

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  user    User    @relation("exceptionUser", fields: [userId], references: [id])
  feature Feature @relation(fields: [featureId], references: [id])

  @@unique([tenantId, userId, featureId])
  @@map("user_feature_exceptions")
}

// -------------------------------------------------------------------- audit

enum AuditActorType {
  USER
  PLATFORM
  SYSTEM
}

/// Immutable who/what/when record (Product Constitution §3).
/// Append-only by convention: no update path exists in application code,
/// and there is no updatedAt on purpose.
model AuditEvent {
  id          String         @id @default(uuid()) @db.Uuid
  /// Null only for platform-level events with no tenant context.
  tenantId    String?        @db.Uuid
  actorUserId String?        @db.Uuid
  actorType   AuditActorType @default(USER)
  /// Dotted action key, e.g. "module.disabled", "role.permissions_changed".
  action      String
  entityType  String
  entityId    String?
  reason      String?
  /// Before/after values for changes (Constitution §3).
  before      Json?
  after       Json?
  metadata    Json?
  createdAt   DateTime       @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id])
  actor  User?   @relation("auditActor", fields: [actorUserId], references: [id])

  @@index([tenantId, createdAt])
  @@index([tenantId, entityType, entityId])
  @@map("audit_events")
}

// ------------------------------------------------------------- departments

/// An organisational unit inside a tenant. Distinct from Branch, which is a
/// PLACE: a company can run Dispatch and Accounts out of one warehouse, and
/// one Dispatch department across three warehouses.
///
/// The head is who receives action tiles for their people alongside the
/// admins (src/lib/actions/audience.ts).
model Department {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String  @db.Uuid
  name     String
  /// Department head. Null = no head yet; tiles go to tenant admins only,
  /// and the directory says so rather than silently dropping them.
  headId   String? @db.Uuid
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant             @relation(fields: [tenantId], references: [id])
  head    TenantMembership?  @relation("departmentHead", fields: [headId], references: [id])
  members TenantMembership[] @relation("departmentMembers")

  @@unique([tenantId, name])
  @@index([tenantId, isActive])
  @@map("departments")
}

/// A job title the company uses — "Delivery Executive", "Store Manager" —
/// tied once to an access level (a Role). Adding a person means picking a
/// designation; what they can see follows from it (27 Sept 2026: one field
/// instead of separate Role and Designation).
model Designation {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  name      String
  roleId    String   @db.Uuid
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant             @relation(fields: [tenantId], references: [id])
  role        Role               @relation(fields: [roleId], references: [id])
  memberships TenantMembership[]

  @@unique([tenantId, name])
  @@index([tenantId, isActive])
  @@map("designations")
}

// ----------------------------------------------------------------- invites

enum InviteStatus {
  /// Sent (or ready to send) and not yet accepted.
  PENDING
  /// The person set a password and signed in.
  ACCEPTED
  /// Past expiresAt without acceptance. Resend issues a NEW token.
  EXPIRED
  /// Withdrawn by an admin, or the employee was deactivated first.
  REVOKED
}

/// Delivery route for an invitation. Email is the only channel that can
/// actually reach someone today; LINK is the honest fallback for workers
/// with no email address, where the admin passes the link on themselves
/// (WhatsApp, printed slip). Phone/OTP stays blocked on D-P1-05.
enum InviteChannel {
  EMAIL
  LINK
}

/// An outstanding invitation to join a tenant.
///
/// The raw token is shown ONCE, at creation, and only its SHA-256 hash is
/// stored — a leaked database backup must not yield working invitation
/// links (SECURITY-NOTES.md).
model EmployeeInvite {
  id           String        @id @default(uuid()) @db.Uuid
  tenantId     String        @db.Uuid
  membershipId String        @db.Uuid
  /// SHA-256 of the raw token. Never the token itself.
  tokenHash    String        @unique
  channel      InviteChannel @default(EMAIL)
  status       InviteStatus  @default(PENDING)
  /// The address this invitation was sent to, recorded at send time so a
  /// later profile edit cannot rewrite where it actually went.
  sentToEmail  String?
  expiresAt    DateTime
  sentAt       DateTime?
  acceptedAt   DateTime?
  revokedAt    DateTime?
  /// How many times an admin re-sent. Rate-limited in the action.
  resendCount  Int           @default(0)
  lastResendAt DateTime?
  createdById  String?       @db.Uuid
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  tenant     Tenant           @relation(fields: [tenantId], references: [id])
  membership TenantMembership @relation(fields: [membershipId], references: [id])

  @@index([tenantId, status])
  @@index([membershipId])
  @@map("employee_invites")
}

// --------------------------------------------------------- action requests

/// What kind of decision is being asked for. Each maps to an existing
/// approval surface — this queue routes and chases, it never invents a new
/// approval step.
enum ActionRequestKind {
  ATTENDANCE_EXCEPTION
  LEAVE_REQUEST
  TASK_PROOF
  EMPLOYEE_INVITE
  REWARD_REDEMPTION
  EXPENSE_CLAIM
  FIELD_TRIP
}

enum ActionRequestStatus {
  /// Waiting for someone in the audience to decide.
  PENDING
  /// Hidden until snoozedUntil, then PENDING again.
  SNOOZED
  /// Someone decided. Records who, so a second reviewer is not asked again.
  RESOLVED
  /// The underlying subject went away (task deleted, leave withdrawn).
  CANCELLED
}

/// One decision awaiting a human, addressed to a set of people.
///
/// This is deliberately a table and not a derived query: a snooze is a
/// per-person promise about when to ask again, and a promise you cannot
/// survive a restart is not a promise (Constitution §3).
model ActionRequest {
  id          String              @id @default(uuid()) @db.Uuid
  tenantId    String              @db.Uuid
  kind        ActionRequestKind
  status      ActionRequestStatus @default(PENDING)
  /// The row this decision is about, e.g. an attendance_records id.
  subjectType String
  subjectId   String              @db.Uuid
  /// Whose work this concerns — used to find their department head.
  aboutMembershipId String?       @db.Uuid
  /// Plain-language summary, rendered as-is. Written once at creation so
  /// the tile cannot drift from what was recorded (integrity pattern 1).
  title       String
  body        String?
  /// Where the decision is actually made.
  href        String
  /// Set when someone acts, so the tile disappears for everyone.
  resolvedAt      DateTime?
  resolvedByUserId String?        @db.Uuid
  resolution      String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  tenant     Tenant                  @relation(fields: [tenantId], references: [id])
  about      TenantMembership?       @relation("actionAbout", fields: [aboutMembershipId], references: [id])
  recipients ActionRequestRecipient[]

  @@unique([tenantId, subjectType, subjectId])
  @@index([tenantId, status])
  @@map("action_requests")
}

/// One addressee of an action request. Snooze is per-person: a supervisor
/// putting something off must not hide it from the owner.
model ActionRequestRecipient {
  id              String    @id @default(uuid()) @db.Uuid
  actionRequestId String    @db.Uuid
  tenantId        String    @db.Uuid
  userId          String    @db.Uuid
  /// Why this person is being asked — shown in the tile so nobody wonders
  /// why it reached them ("You are the head of Dispatch").
  reason          String
  /// Hidden until this time for THIS person only.
  snoozedUntil    DateTime?
  snoozeCount     Int       @default(0)
  seenAt          DateTime?
  createdAt       DateTime  @default(now())

  actionRequest ActionRequest @relation(fields: [actionRequestId], references: [id], onDelete: Cascade)

  @@unique([actionRequestId, userId])
  @@index([tenantId, userId, snoozedUntil])
  @@map("action_request_recipients")
}

// ---------------------------------------------------- performance P2–P5

/// One earned achievement — a catalog badge, or a level celebration row
/// (badgeKey "level_1".."level_4", filtered off the badge wall). Earned
/// once, kept forever; `celebratedAt` marks the full-screen moment as
/// shown so it fires exactly once (PERFORMANCE-MODULE.md §B).
model EmployeeBadge {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @db.Uuid
  membershipId String    @db.Uuid
  /// Key into the code catalog (src/lib/performance/badges.ts / levels.ts).
  badgeKey     String
  earnedAt     DateTime  @default(now())
  celebratedAt DateTime?

  tenant     Tenant           @relation(fields: [tenantId], references: [id])
  membership TenantMembership @relation(fields: [membershipId], references: [id])

  @@unique([tenantId, membershipId, badgeKey])
  @@index([tenantId, membershipId, celebratedAt])
  @@map("employee_badges")
}

/// A double-points window an admin declared (festival rush, stock-taking).
/// Applied at award time; existing rows are never rewritten.
model PerformanceBoost {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  /// Why, in the admin's words — shown on the Home widget banner.
  name        String
  /// Date-only bounds, inclusive, in the tenant's timezone.
  startDate   DateTime @db.Date
  endDate     DateTime @db.Date
  multiplier  Int      @default(2)
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, startDate, endDate])
  @@map("performance_boosts")
}

/// Something points can be redeemed for. Defined by the tenant; never
/// money inside FlowHRMS (D-P3-01) — cash goes through payroll adjustments.
model Reward {
  id          String  @id @default(uuid()) @db.Uuid
  tenantId    String  @db.Uuid
  name        String
  description String?
  pointCost   Int
  /// Null = unlimited. Decremented on approval, not on request.
  stock       Int?
  isActive    Boolean @default(true)
  sortOrder   Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant             @relation(fields: [tenantId], references: [id])
  redemptions RewardRedemption[]

  @@index([tenantId, isActive])
  @@map("rewards")
}

enum RedemptionStatus {
  /// Points are held; an action tile is asking for a decision.
  PENDING
  /// Handed over. Points stay spent; stock decremented.
  APPROVED
  /// Refused. Points return automatically; the reason is shown verbatim.
  REJECTED
  /// Withdrawn by the employee while still pending. Points return.
  CANCELLED
}

/// One spend of points. The balance is earned minus PENDING+APPROVED
/// redemptions, so a rejection returns the points by arithmetic — there
/// is no compensating write to forget.
model RewardRedemption {
  id           String           @id @default(uuid()) @db.Uuid
  tenantId     String           @db.Uuid
  rewardId     String           @db.Uuid
  membershipId String           @db.Uuid
  /// Cost at request time — a later price change never rewrites history.
  points       Int
  /// Reward name at request time, so history survives a renamed reward.
  rewardName   String
  status       RedemptionStatus @default(PENDING)
  decidedById  String?          @db.Uuid
  decidedAt    DateTime?
  /// Shown to the employee word for word on rejection.
  decisionReason String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  tenant     Tenant           @relation(fields: [tenantId], references: [id])
  reward     Reward           @relation(fields: [rewardId], references: [id])
  membership TenantMembership @relation(fields: [membershipId], references: [id])

  @@index([tenantId, membershipId, status])
  @@index([tenantId, status])
  @@map("reward_redemptions")
}

/// A thank-you from a manager — words only, never points (principle 1:
/// no points from opinions). Capped per sender per week in the action.
model Kudos {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @db.Uuid
  fromMembershipId String   @db.Uuid
  toMembershipId   String   @db.Uuid
  message          String
  createdAt        DateTime @default(now())

  tenant Tenant           @relation(fields: [tenantId], references: [id])
  from   TenantMembership @relation("kudosFrom", fields: [fromMembershipId], references: [id])
  to     TenantMembership @relation("kudosTo", fields: [toMembershipId], references: [id])

  @@index([tenantId, toMembershipId, createdAt])
  @@index([tenantId, fromMembershipId, createdAt])
  @@map("kudos")
}

// ---------------------------------------------------------------- expenses
// EXPENSES-MODULE.md §9. Five tables; no foreign key to Payroll, ever —
// Expenses works with Payroll off, and a settlement stores only an id.

enum ExpenseClaimStatus {
  DRAFT
  SUBMITTED
  APPROVED
  PARTIALLY_APPROVED
  REJECTED
  WITHDRAWN
  SETTLED
}

enum ExpenseSettlementRoute {
  PAYROLL
  OUTSIDE
}

/// One claim. Amounts in rupees with paise (Decimal 12,2), INR only.
/// Category and rules are SNAPSHOTS at submission (invariant 11). Status
/// changes only through src/lib/expenses/transition.ts.
model ExpenseClaim {
  id             String             @id @default(uuid()) @db.Uuid
  tenantId       String             @db.Uuid
  membershipId   String             @db.Uuid
  /// Per-tenant sequence assigned at submission; shown as EXP-000042.
  claimNumber    Int
  status         ExpenseClaimStatus @default(DRAFT)

  categoryKey    String
  categoryName   String
  receiptRequiredAtSubmission Boolean
  maxClaimAmountAtSubmission  Decimal? @db.Decimal(12, 2)

  claimedAmount  Decimal            @db.Decimal(12, 2)
  approvedAmount Decimal?           @db.Decimal(12, 2)
  expenseDate    DateTime           @db.Date
  description    String

  /// Facts for the approver, computed once at submission (invariant 12).
  isLate         Boolean            @default(false)
  isOverCap      Boolean            @default(false)
  isPossibleDuplicate Boolean       @default(false)

  submittedAt    DateTime?
  policyVersion  Int?
  decidedById    String?            @db.Uuid
  decidedAt      DateTime?
  /// Shown to the employee word for word.
  decisionReason String?
  settledAt      DateTime?
  /// Set by the claimant's own withdrawal (invariant 13); reason optional,
  /// in their words, visible to anyone who can see the claim.
  withdrawnAt    DateTime?
  withdrawalReason String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  tenant      Tenant                   @relation(fields: [tenantId], references: [id])
  membership  TenantMembership         @relation(fields: [membershipId], references: [id])
  receipts    ExpenseReceipt[]
  transitions ExpenseClaimTransition[]
  settlement  ExpenseSettlement?
  /// Set when the claim is a travel allowance made from field visits.
  fieldConveyance FieldConveyance?

  @@unique([tenantId, claimNumber])
  @@index([tenantId, membershipId, status])
  @@index([tenantId, status, submittedAt])
  @@index([tenantId, expenseDate])
  @@map("expense_claims")
}

/// A receipt image or PDF. The file lives in the PRIVATE bucket
/// `expense-receipts`; only `path` is stored (pattern: ProofFile).
model ExpenseReceipt {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  claimId      String   @db.Uuid
  path         String
  name         String
  mime         String
  sizeBytes    Int
  uploadedById String   @db.Uuid
  createdAt    DateTime @default(now())

  claim ExpenseClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([tenantId, claimId])
  @@map("expense_receipts")
}

/// The claim's own history — who moved it, from what, to what, why.
/// Append-only by convention (no update path, no updatedAt), like AuditEvent.
model ExpenseClaimTransition {
  id             String              @id @default(uuid()) @db.Uuid
  tenantId       String              @db.Uuid
  claimId        String              @db.Uuid
  fromStatus     ExpenseClaimStatus?
  toStatus       ExpenseClaimStatus
  actorUserId    String?             @db.Uuid
  actorType      AuditActorType      @default(USER)
  reason         String?
  /// Amount decided at this step, when the step decides one.
  approvedAmount Decimal?            @db.Decimal(12, 2)
  selfApproved   Boolean             @default(false)
  createdAt      DateTime            @default(now())

  claim ExpenseClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([tenantId, claimId, createdAt])
  @@map("expense_claim_transitions")
}

/// How an approved claim was paid — a RECORD, not a payment.
model ExpenseSettlement {
  id                  String                 @id @default(uuid()) @db.Uuid
  tenantId            String                 @db.Uuid
  claimId             String                 @unique @db.Uuid
  route               ExpenseSettlementRoute
  amount              Decimal                @db.Decimal(12, 2)
  /// OUTSIDE: free text ("cash 12 Sept, voucher 118"). PAYROLL: run month.
  reference           String?
  /// Set only for PAYROLL; unique so one adjustment settles one claim.
  payrollAdjustmentId String?                @unique @db.Uuid
  settledById         String                 @db.Uuid
  settledAt           DateTime               @default(now())

  claim ExpenseClaim @relation(fields: [claimId], references: [id])

  @@index([tenantId, settledAt])
  @@map("expense_settlements")
}

/// Per-tenant claim counter, advanced atomically inside the submit
/// transaction (single INSERT … ON CONFLICT … RETURNING).
model ExpenseCounter {
  tenantId String @id @db.Uuid
  next     Int    @default(1)

  @@map("expense_counters")
}

// ---------------------------------------------------------------- field visits
//
// FIELD-VISITS-MODULE.md. Location is captured only at the four taps —
// Going out, Reached, End visit, Back at office — never in between. A trip
// lives inside an open working day, so its time is working time.

enum FieldTripApproval {
  /// The company's rules don't ask for approval of going out.
  NOT_NEEDED
  PENDING
  APPROVED
  DECLINED
}

enum FieldTripEnd {
  BACK_AT_OFFICE
  CHECKED_OUT
  /// The day closed with the trip still open; fixed by a correction.
  NOT_RECORDED
}

enum FieldVisitEnd {
  ENDED
  CHECKED_OUT
  NOT_RECORDED
  CORRECTED
}

enum FieldLegMethod {
  ROAD
  /// Shown as an estimate until the road figure arrives.
  STRAIGHT
}

enum FieldLegStatus {
  PENDING
  DONE
  FAILED
}

/// A place people visit, shared across the company and called whatever the
/// company calls it ("customer", "party", "site"). The spot comes from the
/// first visit. One-time places are never saved here.
model FieldPlace {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  name        String
  /// Lower-cased with spaces collapsed, to spot "Sharma  traders" as a repeat.
  nameKey     String
  address     String?
  lat         Float
  lng         Float
  /// Retired places stay for history and are no longer offered.
  isActive    Boolean  @default(true)
  /// Membership that added it.
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant       @relation(fields: [tenantId], references: [id])
  visits FieldVisit[]

  @@index([tenantId, isActive])
  @@index([tenantId, nameKey])
  @@map("field_places")
}

/// Going out to back at office, inside one working day.
model FieldTrip {
  id           String @id @default(uuid()) @db.Uuid
  tenantId     String @db.Uuid
  membershipId String @db.Uuid
  /// The working day this trip belongs to.
  recordId     String @db.Uuid

  startedAt       DateTime
  /// The phone's own time, as on attendance punches.
  startedClientAt DateTime?
  startLat        Float?
  startLng        Float?
  startAccuracyM  Float?
  /// "Going out" was skipped; the start is estimated from road travel time.
  startEstimated  Boolean   @default(false)

  /// Null while the person is out.
  endedAt       DateTime?
  endedClientAt DateTime?
  endLat        Float?
  endLng        Float?
  endAccuracyM  Float?
  endKind       FieldTripEnd?

  /// Asked of the reporting manager; the trip never waits for it.
  approval            FieldTripApproval @default(NOT_NEEDED)
  approvalDecidedById String?           @db.Uuid
  approvalDecidedAt   DateTime?
  /// Shown to the person word for word.
  approvalReason      String?

  /// Version of the company's field visit rules when the trip started.
  policyVersion   Int
  offlineCaptured Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant     Tenant           @relation(fields: [tenantId], references: [id])
  membership TenantMembership @relation(fields: [membershipId], references: [id])
  record     AttendanceRecord @relation(fields: [recordId], references: [id])
  visits     FieldVisit[]
  legs       FieldLeg[]

  @@index([tenantId, membershipId, startedAt])
  @@index([tenantId, startedAt])
  @@index([tenantId, approval])
  @@map("field_trips")
}

/// Reached to End visit. Place and purpose are snapshots: renaming either
/// later never rewrites a visit already made.
model FieldVisit {
  id           String @id @default(uuid()) @db.Uuid
  tenantId     String @db.Uuid
  tripId       String @db.Uuid
  membershipId String @db.Uuid
  /// 1 for the trip's first visit, then 2, 3.
  sequence     Int

  /// Null for a one-time place.
  placeId     String? @db.Uuid
  placeName   String
  purposeKey  String?
  purposeName String?

  arrivedAt          DateTime
  arrivedClientAt    DateTime?
  arriveLat          Float?
  arriveLng          Float?
  arriveAccuracyM    Float?
  /// From the saved place's spot; null for new and one-time places.
  distanceFromPlaceM Float?
  /// Further than the company's "away from saved spot" distance. Informs, never blocks.
  isFar              Boolean   @default(false)

  /// Null while the person is there.
  leftAt        DateTime?
  leftClientAt  DateTime?
  leftLat       Float?
  leftLng       Float?
  leftAccuracyM Float?
  endKind       FieldVisitEnd?

  note            String?
  /// In the private company-media bucket, when a photo was taken.
  photoPath       String?
  offlineCaptured Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant Tenant      @relation(fields: [tenantId], references: [id])
  trip   FieldTrip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  place  FieldPlace? @relation(fields: [placeId], references: [id])

  @@unique([tripId, sequence])
  @@index([tenantId, membershipId, arrivedAt])
  @@index([tenantId, placeId])
  @@map("field_visits")
}

/// One stretch of road between two tapped spots. Distance is by road
/// (Google Routes); a straight-line figure is only a marked estimate.
model FieldLeg {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tripId   String @db.Uuid
  /// 1 for the trip's first stretch, then 2, 3.
  sequence Int

  fromLat Float
  fromLng Float
  fromAt  DateTime
  toLat   Float
  toLng   Float
  toAt    DateTime

  meters          Int?
  durationSeconds Int?
  method          FieldLegMethod?
  status          FieldLegStatus  @default(PENDING)
  /// Encoded route line for the map.
  polyline        String?
  attempts        Int             @default(0)
  /// When the road distance was last asked for; retries back off from here.
  lastTriedAt     DateTime?
  computedAt      DateTime?
  createdAt       DateTime        @default(now())

  tenant Tenant    @relation(fields: [tenantId], references: [id])
  trip   FieldTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([tripId, sequence])
  @@index([tenantId, status])
  @@map("field_legs")
}

// ---------------------------------------------------------------- consent (DPDP)
//
// Proof of notice and consent under the Digital Personal Data Protection
// Act, 2023 and DPDP Rules, 2025. Section 6(10) puts the burden of proving
// that notice was given and consent obtained on the Data Fiduciary, so
// every consent is a permanent record of WHAT was shown (the exact
// published text, by hash) and WHAT was agreed. See docs/md/DPDP-COMPLIANCE.md.

enum ConsentNoticeStatus {
  PUBLISHED
  RETIRED
}

/// One published version of a notice or policy document. Never edited once
/// written — a database trigger refuses changes to its text. A wording
/// change is a new version, and everyone re-consents to it.
model ConsentNotice {
  id            String              @id @default(uuid()) @db.Uuid
  /// account_holder | customer_terms | employee | terms | privacy
  key           String
  version       Int
  language      String              @default("en")
  title         String
  /// The exact document shown, as canonical JSON (src/lib/consent/documents.ts).
  body          String
  /// sha256 of `body` — what a consent record points at.
  sha256        String
  status        ConsentNoticeStatus @default(PUBLISHED)
  /// Drafted in-house; false until a lawyer has reviewed this version.
  /// Shown only in the platform area, never to customers.
  legalReviewed Boolean             @default(false)
  legalReviewedAt DateTime?
  legalReviewedBy String?
  publishedAt   DateTime            @default(now())

  records ConsentRecord[]

  @@unique([key, version, language])
  @@map("consent_notices")
}

enum ConsentSubject {
  ACCOUNT_HOLDER
  EMPLOYEE
}

enum ConsentAction {
  GRANTED
  /// Optional choices changed; required consent still given.
  UPDATED
  WITHDRAWN
}

/// Append-only. A trigger refuses UPDATE, DELETE and TRUNCATE, and each
/// row carries the hash of the one before it, so a removed or altered row
/// breaks the chain visibly. Deliberately no foreign keys to users or
/// tenants: the proof must outlive a deleted account or company.
model ConsentRecord {
  id            String         @id @default(uuid()) @db.Uuid
  /// Chain order.
  seq           Int            @unique @default(autoincrement())
  noticeId      String         @db.Uuid
  noticeKey     String
  noticeVersion Int
  noticeHash    String
  userId        String?        @db.Uuid
  email         String
  tenantId      String?        @db.Uuid
  tenantName    String?
  subject       ConsentSubject
  action        ConsentAction
  /// [{ key, label, required, granted }]
  purposes      Json
  /// Other documents accepted with this one: { terms: {version, sha256}, … }
  documents     Json?
  /// How consent was expressed, e.g. "checkbox+submit:/start".
  method        String
  language      String         @default("en")
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime
  prevHash      String
  recordHash    String         @unique

  notice ConsentNotice @relation(fields: [noticeId], references: [id])

  @@index([email])
  @@index([userId])
  @@index([tenantId])
  @@index([noticeKey, noticeVersion])
  @@map("consent_records")
}

enum DataRequestType {
  ACCESS
  CORRECTION
  ERASURE
  GRIEVANCE
  WITHDRAWAL
}

enum DataRequestStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  REJECTED
}

/// A Data Principal exercising a right (DPDP Act ss. 11–13). Answered within
/// 90 days (Rule 14). No foreign keys, for the same reason as consent.
model DataRequest {
  id          String            @id @default(uuid()) @db.Uuid
  userId      String?           @db.Uuid
  email       String
  tenantId    String?           @db.Uuid
  tenantName  String?
  type        DataRequestType
  details     String
  status      DataRequestStatus @default(OPEN)
  dueAt       DateTime
  response    String?
  handledById String?           @db.Uuid
  handledAt   DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([status, dueAt])
  @@index([email])
  @@map("data_requests")
}

// ---------------------------------------------------------------- platform

/// Flowacord-wide settings, e.g. the trial length and module package.
model PlatformSetting {
  key         String   @id
  value       Json
  updatedById String?  @db.Uuid
  updatedAt   DateTime @updatedAt

  @@map("platform_settings")
}

/// A one-time link proving someone controls an email address. Only the
/// sha256 of the token is stored, as with invitations.
model EmailVerification {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  userId    String    @db.Uuid
  email     String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([tenantId])
  @@map("email_verifications")
}

// ----------------------------------------------------------------- billing
//
// Paid subscriptions (27 Sept 2026). A company pays per period — a month or
// a year — for its active employees at its plan's rate, plus 18% GST, by
// Razorpay. Paying moves `paidUntil` forward; 7 days after it passes the
// company pauses, like an ended trial. Nothing renews by itself.

enum BillingCycle {
  MONTHLY
  ANNUAL
}

enum BillingPaymentStatus {
  /// A Razorpay order exists; the customer has not paid yet (or gave up).
  CREATED
  PAID
  FAILED
}

/// A plan Flowacord sells. Prices, modules and the marketing bullet list
/// are edited in /platform/plans; the website and the in-app subscription
/// page both read from here.
model BillingPlan {
  id           String   @id @default(uuid()) @db.Uuid
  key          String   @unique
  name         String
  /// Who it is for, in the customer's words.
  target       String
  /// The base price for a month, whole rupees, excluding GST.
  priceMonthly Int
  /// The base price for a year paid at once, whole rupees, excluding GST.
  priceAnnual  Int
  /// Active employees the base price covers.
  includedEmployees    Int @default(0)
  /// Whole rupees per active employee above includedEmployees, per month.
  extraEmployeeMonthly Int @default(0)
  /// Whole rupees per active employee above includedEmployees, per year.
  extraEmployeeAnnual  Int @default(0)
  /// Module keys a company on this plan gets (src/lib/catalog.ts MODULES).
  modules      String[]
  /// [{ label, strong? }] — the bullet list on the website and in the app.
  features     Json
  flagship     Boolean  @default(false)
  /// Hidden plans are not offered to new buyers; companies on them keep them.
  active       Boolean  @default(true)
  sortOrder    Int      @default(0)
  updatedById  String?  @db.Uuid
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenants Tenant[]

  @@map("billing_plans")
}

/// One attempt to pay, and — once paid — the tax invoice for it. No foreign
/// key to the company: financial records must outlive a deleted company
/// (CGST Rules r.56 keeps accounts for 72 months), so the names are copied.
model BillingPayment {
  id                String               @id @default(uuid()) @db.Uuid
  tenantId          String               @db.Uuid
  tenantName        String
  planId            String               @db.Uuid
  planKey           String
  planName          String
  cycle             BillingCycle
  months            Int
  /// Active employees counted when the order was made.
  employees         Int
  /// The plan's price at the time, whole rupees: the base price for the
  /// cycle, the employees it covered, and each extra employee's price.
  baseRupees        Int @default(0)
  includedEmployees Int @default(0)
  extraEmployees    Int @default(0)
  extraRateRupees   Int @default(0)
  /// Legacy per-employee rate (plans before CORE/PRO/BUSINESS). Never
  /// written since 29 Sept 2026; kept nullable so the build still live
  /// during the switch could run. Drop it in a later migration.
  rateRupees        Int?
  /// Amounts in paise.
  subtotalPaise     Int
  cgstPaise         Int                  @default(0)
  sgstPaise         Int                  @default(0)
  igstPaise         Int                  @default(0)
  totalPaise        Int
  status            BillingPaymentStatus @default(CREATED)
  razorpayOrderId   String               @unique
  razorpayPaymentId String?              @unique
  /// The buyer as they will appear on the invoice: name, GSTIN, address, state.
  buyer             Json
  periodStart       DateTime?
  periodEnd         DateTime?
  paidAt            DateTime?
  /// FH/2627/00001 — consecutive per financial year (CGST Rules r.46(b)).
  invoiceNumber     String?              @unique
  /// Everything printed on the invoice, frozen when it was issued.
  invoice           Json?
  failureReason     String?
  createdById       String?              @db.Uuid
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([tenantId, createdAt])
  @@index([status])
  @@map("billing_payments")
}

/// The last invoice number used in each Indian financial year ("2627" =
/// April 2026 – March 2027). Incremented inside the payment transaction.
model InvoiceCounter {
  financialYear String @id
  last          Int    @default(0)

  @@map("invoice_counters")
}

// ------------------------------------------------ sign-up contact checks

enum ContactChannel {
  EMAIL
  SMS
}

/// A one-time code proving someone controls an email address or mobile
/// number while they sign up (/start, step 3). Only a hash of the code is
/// kept. Codes last 10 minutes and allow 5 tries; a verified row is proof
/// for 30 minutes and is used once, by the sign-up it belongs to.
model SignupVerification {
  id         String         @id @default(uuid()) @db.Uuid
  channel    ContactChannel
  /// Normalised email, or the 10-digit mobile number.
  target     String
  codeHash   String
  expiresAt  DateTime
  attempts   Int            @default(0)
  verifiedAt DateTime?
  usedAt     DateTime?
  ipAddress  String?
  createdAt  DateTime       @default(now())

  @@index([channel, target, createdAt])
  @@index([ipAddress, createdAt])
  @@map("signup_verifications")
}

/// What a code emailed to Flowacord unlocks: the platform actions that lock
/// a whole company out (lib/platform/lockout-code.ts).
enum PlatformLockoutAction {
  SUSPEND
  END_TRIAL
}

/// A one-time code emailed to Flowacord's own inbox before a company is
/// locked out. No platform admin can suspend a company or end its trial
/// without it. Hashed with the row id; one use; ten minutes; five tries;
/// bound to the company, the action and the admin who asked. The reason is
/// fixed when the code is sent, so the email shows exactly what will be
/// recorded. No foreign keys: the record outlives the people and companies
/// it names (purge.ts clears a deleted company's rows).
model PlatformActionCode {
  id            String                @id @default(uuid()) @db.Uuid
  action        PlatformLockoutAction
  tenantId      String                @db.Uuid
  requestedById String                @db.Uuid
  codeHash      String
  /// Where it was emailed — always PLATFORM_APPROVAL_EMAIL at the time.
  sentTo        String
  reason        String
  attempts      Int                   @default(0)
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime              @default(now())

  @@index([requestedById, createdAt])
  @@index([tenantId, createdAt])
  @@map("platform_action_codes")
}

/// The evidence behind a travel allowance claim made from field visits
/// (FIELD-VISITS-MODULE.md §7). The expense claim is the claim — approved,
/// settled and paid like any other; this records, at submission, what it
/// was worked out from, so the approver sees recorded and claimed side by
/// side and nobody can recompute it later into something else.
model FieldConveyance {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  membershipId String   @db.Uuid
  claimId      String   @unique @db.Uuid
  /// "2026-09". One live claim per person per month (checked under a lock).
  month        String
  vehicleKey   String
  vehicleName  String
  ratePerKm    Decimal  @db.Decimal(8, 2)
  /// From the month's trips, declined trips left out.
  recordedKm   Decimal  @db.Decimal(10, 1)
  /// Of recordedKm, straight-line estimates (road distance not known).
  estimatedKm  Decimal  @db.Decimal(10, 1)
  claimedKm    Decimal  @db.Decimal(10, 1)
  /// Why claimedKm differs from recordedKm, in the person's words.
  changeReason String?
  tripsCounted  Int
  tripsAwaiting Int
  tripsDeclined Int
  /// Per day: date, km, estimated km, trips — what the approver can check.
  days         Json
  createdAt    DateTime @default(now())

  tenant     Tenant           @relation(fields: [tenantId], references: [id])
  membership TenantMembership @relation(fields: [membershipId], references: [id])
  claim      ExpenseClaim     @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([tenantId, membershipId, month])
  @@map("field_conveyances")
}
